SECRET_KEY=

ACCESS_TOKEN_SECRET=
JWT_ALGORITHM=HS256

# Email
# Set to django.core.mail.backends.smtp.EmailBackend to actually send mail
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_SSL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

DEBUG=True

# Comma-separated. Keep ALLOWED_HOSTS narrow in production.
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=

# Virtual host routing (labpro/hosts.py). Comma-separated, no port.
BACKEND_HOSTS=labpro.local
API_HOSTS=api.labpro.local,localhost
VIRTUAL_HOST_PORTS=8000

# For PostgreSQL
DATABASES_ENGINE=django.db.backends.postgresql
DATABASES_NAME=
DATABASES_USER=
DATABASES_PASSWORD=
DATABASES_HOST=
DATABASES_PORT=

# For Redis Cache
REDIS_URL=
CACHE_DEFAULT_TIMEOUT=2700

# For Cloudflare R2
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_BUCKET_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
# Public CDN hostname serving the bucket (no scheme, no trailing slash)
CLOUDFLARE_R2_CUSTOM_DOMAIN=labproflix-cdn.faizath.com

# Invidious instance used to resolve movie trailers
INVIDIOUS_API_URL=https://inv.altsite.org

LANGUAGE_CODE=en-us
TIME_ZONE=UTC
